---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { SITE_TITLE } from '../../consts';

const brands = await getCollection('brands');
const sortedBrands = brands.sort((a, b) => (a.data.minPriceValue || 0) - (b.data.minPriceValue || 0));
---

<Layout title={`品牌库｜梯子排行`} description="完整收录29家主流梯子排行与机场品牌，提供详细的参数对比、价格与专属优惠码。">
  <div class="max-w-7xl mx-auto px-4 py-12">
    <div class="text-center mb-12">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">机场品牌大全</h1>
      <p class="text-xl text-gray-400">完整收录全网29家主流品牌，持续更新评测数据与优惠</p>
    </div>

    <!-- 交互式搜索与筛选 -->
    <div class="glass-card p-4 mb-10 flex flex-col md:flex-row gap-4 items-center">
      <div class="relative w-full md:w-96">
        <input id="brand-search-input" type="text" placeholder="搜索品牌名称..." class="w-full bg-white/5 border border-white/10 rounded-lg py-2 pl-10 pr-4 text-white focus:outline-none focus:border-primary transition-colors" />
        <svg class="w-5 h-5 absolute left-3 top-2.5 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
        <button id="clear-search-btn" class="absolute right-3 top-2.5 text-gray-500 hover:text-white hidden">
           <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
      </div>
      <div class="flex gap-2 w-full md:w-auto overflow-x-auto pb-2 md:pb-0 hide-scrollbar" id="filter-buttons">
        <button data-filter="all" class="filter-btn px-4 py-2 rounded-lg bg-primary text-white text-sm whitespace-nowrap transition-colors">全部品牌</button>
        <button data-filter="coupon" class="filter-btn px-4 py-2 rounded-lg bg-white/5 hover:bg-white/10 text-gray-300 text-sm whitespace-nowrap transition-colors">含优惠码</button>
        <button data-filter="streaming" class="filter-btn px-4 py-2 rounded-lg bg-white/5 hover:bg-white/10 text-gray-300 text-sm whitespace-nowrap transition-colors">支持流媒体</button>
      </div>
    </div>

    <!-- 品牌列表 -->
    <div id="brands-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {sortedBrands.map(brand => {
        const hasCoupon = !!brand.data.couponCode;
        const featuresAndTags = [...(brand.data.features || []), ...(brand.data.tags || [])].join(' ');
        const isStreaming = featuresAndTags.includes('流媒体');
        
        return (
        <a href={`/brands/${brand.id}`} 
           class="brand-card glass-card p-6 block hover:-translate-y-1 transition-transform group"
           data-name={brand.data.name.toLowerCase()}
           data-coupon={hasCoupon.toString()}
           data-streaming={isStreaming.toString()}>
          <div class="flex justify-between items-start mb-4">
            <h2 class="text-2xl font-bold group-hover:text-primary transition-colors">{brand.data.name}</h2>
          </div>
          
          <div class="flex flex-wrap gap-1 mb-4">
            {brand.data.tags?.map((tag: string) => (
              <span class="text-xs text-gray-400 bg-white/5 px-2 py-1 rounded">{tag}</span>
            ))}
          </div>

          <div class="space-y-2 text-sm text-gray-300 mb-6">
            <div class="flex justify-between border-b border-white/5 pb-2">
              <span class="text-gray-500">最低价格</span>
              <span class="font-semibold text-white">{brand.data.minPrice?.value || '待核实'}</span>
            </div>
            <div class="flex justify-between border-b border-white/5 pb-2">
              <span class="text-gray-500">基础流量</span>
              <span class="font-semibold text-white truncate max-w-[150px]">{brand.data.trafficInfo?.value || '待核实'}</span>
            </div>
            <div class="flex justify-between border-b border-white/5 pb-2">
              <span class="text-gray-500">支持协议</span>
              <span class="truncate max-w-[150px]">{brand.data.protocols?.join(', ') || '-'}</span>
            </div>
          </div>
          
          {hasCoupon ? (
            <div class="mt-4 py-2 text-center border border-secondary/30 bg-secondary/10 text-secondary rounded text-sm font-mono">
              优惠码: {brand.data.couponCode}
            </div>
          ) : (
            <div class="mt-4 py-2 text-center border border-white/5 text-gray-500 rounded text-sm group-hover:bg-white/5 transition-colors">
              查看详情
            </div>
          )}
        </a>
      )})}
    </div>

    <!-- 无结果提示 -->
    <div id="no-results" class="hidden text-center py-20">
      <div class="text-6xl mb-4">🔍</div>
      <h3 class="text-2xl font-bold text-white mb-2">未找到匹配的品牌</h3>
      <p class="text-gray-400">请尝试更换搜索关键词或筛选条件</p>
      <button id="reset-search-btn" class="mt-6 px-6 py-2 bg-primary hover:bg-primary-dark text-white rounded-lg transition-colors">
        清除搜索与筛选
      </button>
    </div>
  </div>
</Layout>

<script>
  // 客户端过滤逻辑
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('brand-search-input') as HTMLInputElement;
    const clearSearchBtn = document.getElementById('clear-search-btn');
    const resetSearchBtn = document.getElementById('reset-search-btn');
    const filterBtns = document.querySelectorAll('.filter-btn');
    const brandCards = document.querySelectorAll('.brand-card');
    const noResults = document.getElementById('no-results');
    
    let currentFilter = 'all';
    let searchQuery = '';

    function applyFilters() {
      let visibleCount = 0;
      
      brandCards.forEach((card) => {
        const htmlCard = card as HTMLElement;
        const name = htmlCard.dataset.name || '';
        const hasCoupon = htmlCard.dataset.coupon === 'true';
        const isStreaming = htmlCard.dataset.streaming === 'true';
        
        let showBySearch = name.includes(searchQuery);
        let showByFilter = true;
        
        if (currentFilter === 'coupon') showByFilter = hasCoupon;
        if (currentFilter === 'streaming') showByFilter = isStreaming;
        
        if (showBySearch && showByFilter) {
          htmlCard.style.display = 'block';
          visibleCount++;
        } else {
          htmlCard.style.display = 'none';
        }
      });
      
      if (noResults) {
        noResults.style.display = visibleCount === 0 ? 'block' : 'none';
      }
      
      if (clearSearchBtn) {
        clearSearchBtn.style.display = searchQuery.length > 0 ? 'block' : 'none';
      }
    }

    // 搜索事件
    searchInput?.addEventListener('input', (e) => {
      searchQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
      applyFilters();
    });

    // 清除搜索
    clearSearchBtn?.addEventListener('click', () => {
      searchInput.value = '';
      searchQuery = '';
      applyFilters();
    });
    
    // 全局重置
    resetSearchBtn?.addEventListener('click', () => {
      searchInput.value = '';
      searchQuery = '';
      currentFilter = 'all';
      updateFilterUI();
      applyFilters();
    });

    // 筛选按钮点击
    filterBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        currentFilter = target.dataset.filter || 'all';
        updateFilterUI();
        applyFilters();
      });
    });
    
    function updateFilterUI() {
      filterBtns.forEach(btn => {
        const target = btn as HTMLElement;
        if (target.dataset.filter === currentFilter) {
          target.classList.add('bg-primary', 'text-white');
          target.classList.remove('bg-white/5', 'text-gray-300');
        } else {
          target.classList.remove('bg-primary', 'text-white');
          target.classList.add('bg-white/5', 'text-gray-300');
        }
      });
    }
  });
</script>

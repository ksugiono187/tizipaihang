---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { SITE_TITLE } from '../consts';

const allBrands = await getCollection('brands');
// 筛选出有优惠码的品牌
const brandsWithCoupons = allBrands.filter(brand => brand.data.couponCode && brand.data.couponCode.trim() !== '无' && brand.data.couponCode.trim() !== '');

// 简单的按评分降序排列
const sortedBrands = brandsWithCoupons.sort((a, b) => b.data.rating?.value - a.data.rating?.value);
---

<Layout title={`最新机场优惠码大全｜`} description="2026年最新全网翻墙机场优惠码、折扣券收集整理。为您提供最划算的专属折扣代码，购买即省钱。">
  <div class="max-w-7xl mx-auto px-4 py-12">
    
    <!-- Hero Section -->
    <div class="text-center mb-16 relative">
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-64 h-64 bg-purple-500/20 rounded-full blur-[100px] -z-10"></div>
      <span class="inline-block py-1 px-3 rounded-full bg-purple-500/10 border border-purple-500/20 text-purple-400 text-sm font-semibold mb-4">
        省钱利器 · 实时更新
      </span>
      <h1 class="text-4xl md:text-5xl font-bold mb-4 text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-pink-300">
        机场专属优惠码大全
      </h1>
      <p class="text-xl text-gray-400 max-w-2xl mx-auto">
        本站独家搜集并整理了市面上顶级机场的专属折扣码与优惠活动。在购买年付或月付套餐时使用，立享满减与折扣。
      </p>
    </div>

    <!-- Coupons Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {sortedBrands.map(brand => (
        <div class="glass-card overflow-hidden group flex flex-col relative">
          <!-- Discount badge -->
          <div class="absolute -right-12 top-6 bg-red-500 text-white font-bold text-xs py-1 px-12 rotate-45 shadow-lg shadow-red-500/30">
            HOT
          </div>

          <div class="p-6 flex-grow">
            <div class="flex items-center justify-between mb-4">
              <h2 class="text-2xl font-bold text-white group-hover:text-purple-400 transition-colors">{brand.data.name}</h2>
              <span class="text-yellow-400 bg-yellow-400/10 px-2 py-1 rounded text-sm font-semibold">★ {brand.data.rating?.value?.toFixed(1)}</span>
            </div>
            
            <p class="text-gray-400 text-sm mb-6 line-clamp-2">
              {brand.data.trafficInfo?.value} / {brand.data.minPrice?.value}
            </p>

            <div class="bg-black/40 border border-purple-500/30 rounded-xl p-4 mb-4 relative overflow-hidden group/code">
              <div class="absolute inset-0 bg-gradient-to-r from-purple-500/10 to-transparent opacity-0 group-hover/code:opacity-100 transition-opacity"></div>
              <div class="text-xs text-purple-300 mb-1 font-medium">专属折扣代码</div>
              <div class="flex items-center justify-between">
                <span class="font-mono text-2xl font-black text-white tracking-wider">{brand.data.couponCode}</span>
              </div>
            </div>
          </div>
          
          <div class="p-4 border-t border-white/5 bg-white/5 flex gap-3">
            <a href={`/brands/${brand.id}`} class="flex-1 text-center py-2.5 rounded-lg text-sm font-bold text-gray-300 hover:text-white bg-white/5 hover:bg-white/10 transition-colors">
              评测详情
            </a>
            <a href={brand.data.link} target="_blank" rel="noopener noreferrer" class="flex-1 text-center py-2.5 rounded-lg text-sm font-bold text-white bg-purple-600 hover:bg-purple-500 transition-all shadow-[0_0_15px_rgba(147,51,234,0.3)] hover:shadow-[0_0_25px_rgba(147,51,234,0.5)]">
              前往使用
            </a>
          </div>
        </div>
      ))}
    </div>

    {sortedBrands.length === 0 && (
      <div class="text-center py-20 text-gray-500">
        <svg class="w-16 h-16 mx-auto mb-4 opacity-50" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <p class="text-xl">暂时没有可用的优惠码</p>
      </div>
    )}

  </div>
</Layout>

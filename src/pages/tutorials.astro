---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { SITE_TITLE } from '../consts';
import FormattedDate from '../components/FormattedDate.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// 只筛选出标题包含“指南”、“教程”或者ID包含clash, v2ray, shadowrocket等的文章
const tutorials = posts.filter(post => 
  post.data.title.includes('教程') || 
  post.data.title.includes('指南') || 
  post.id.includes('clash') || 
  post.id.includes('v2ray') || 
  post.id.includes('shadowrocket') || 
  post.id.includes('singbox')
);
---

<Layout title={`翻墙教程中心 - ${SITE_TITLE}`} description="最全面的翻墙客户端使用教程、节点配置指南，涵盖 Clash, V2ray, Shadowrocket, Sing-box 等主流工具。">
  <div class="max-w-7xl mx-auto px-4 py-12">
    <div class="text-center mb-16 relative">
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-64 h-64 bg-blue-500/20 rounded-full blur-[100px] -z-10"></div>
      <span class="inline-block py-1 px-3 rounded-full bg-blue-500/10 border border-blue-500/20 text-blue-400 text-sm font-semibold mb-4">
        新手必看 · 进阶玩法
      </span>
      <h1 class="text-4xl md:text-5xl font-bold mb-4 text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-cyan-300">
        全平台翻墙教程中心
      </h1>
      <p class="text-xl text-gray-400 max-w-2xl mx-auto">
        无论您使用 Windows、Mac、iOS 还是 Android，这里都有详尽的图文教程，手把手教您配置科学上网环境。
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {tutorials.slice(0, 30).map((post) => (
        <a href={`/blog/${post.id}/`} class="glass-card group block overflow-hidden rounded-xl">
          <div class="relative overflow-hidden aspect-video">
            <img 
              src={post.data.heroImage || '/blog-placeholder-about.jpg'} 
              alt={post.data.title}
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/90 to-transparent"></div>
            <div class="absolute bottom-4 left-4 right-4">
              <h2 class="text-xl font-bold text-white mb-2 line-clamp-2 group-hover:text-blue-400 transition-colors">
                {post.data.title}
              </h2>
              <div class="text-gray-400 text-sm">
                <FormattedDate date={post.data.pubDate} />
              </div>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</Layout>

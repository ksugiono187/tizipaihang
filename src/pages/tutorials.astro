---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import { SITE_TITLE } from '../consts';
import FormattedDate from '../components/FormattedDate.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// 只筛选出标题包含“指南”、“教程”或者ID包含clash, v2ray, shadowrocket等的文章
const tutorials = posts.filter(post => 
  post.data.title.includes('教程') || 
  post.data.title.includes('指南') || 
  post.id.includes('clash') || 
  post.id.includes('v2ray') || 
  post.id.includes('shadowrocket') || 
  post.id.includes('singbox')
);
---

<Layout title={`翻墙教程中心｜`} description="最全面的翻墙客户端使用教程、节点配置指南，涵盖 Clash, V2ray, Shadowrocket, Sing-box 等主流工具。">
  <div class="max-w-7xl mx-auto px-4 py-12">
    <div class="text-center mb-16 relative">
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-64 h-64 bg-blue-500/20 rounded-full blur-[100px] -z-10"></div>
      <span class="inline-block py-1 px-3 rounded-full bg-blue-500/10 border border-blue-500/20 text-blue-400 text-sm font-semibold mb-4">
        新手必看 · 进阶玩法
      </span>
      <h1 class="text-4xl md:text-5xl font-bold mb-4 text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-cyan-300">
        全平台翻墙教程中心
      </h1>
      <p class="text-xl text-gray-400 max-w-2xl mx-auto">
        无论您使用 Windows、Mac、iOS 还是 Android，这里都有详尽的图文教程，手把手教您配置科学上网环境。
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {tutorials.map((post) => (
        <a href={`/blog/${post.id}/`} class="glass-card rounded-2xl overflow-hidden group hover:-translate-y-2 transition-all duration-300 flex flex-col shadow-lg hover:shadow-blue-500/20 border border-white/5 hover:border-blue-500/30">
          <div class="aspect-video w-full overflow-hidden relative">
            {post.data.heroImage ? (
              <Image 
                src={post.data.heroImage} 
                alt={post.data.title} 
                width={720}
                height={360}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
            ) : (
              <div class="w-full h-full bg-gradient-to-br from-gray-800 to-gray-900 flex items-center justify-center">
                <span class="text-gray-500 text-4xl">📚</span>
              </div>
            )}
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
          </div>
          
          <div class="p-6 flex flex-col flex-grow">
            <h2 class="text-xl font-bold text-white mb-3 line-clamp-2 group-hover:text-blue-400 transition-colors">
              {post.data.title}
            </h2>
            <p class="text-gray-400 text-sm line-clamp-3 mb-4 flex-grow">
              {post.data.description}
            </p>
            <div class="text-xs text-gray-500 font-mono mt-auto flex items-center">
              <svg class="w-4 h-4 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              <FormattedDate date={post.data.pubDate} />
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</Layout>

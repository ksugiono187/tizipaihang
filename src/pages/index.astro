---
import Layout from '../layouts/Layout.astro';
import PingTester from '../components/PingTester.astro';

// 模拟数据用于占位
const top10 = [
  { rank: 1, name: '微风网络 Breezenet', desc: '全网首选高端专线机场，极致稳定', price: '¥25/月起', highlight: 'IEPL专线 / 晚高峰不卡' },
  { rank: 2, name: '飞猫云', desc: '性价比与速度的完美结合', price: '¥15/月起', highlight: '流媒体解锁优 / 节点多' },
  { rank: 3, name: '暮光网络', desc: '新晋热门高性价比机场', price: '¥12/月起', highlight: '便宜 / 不限速' },
];
---

<Layout title="梯子推荐与机场推荐排行（2026）｜梯子排行" description="梯子排行提供2026年梯子推荐、机场推荐、套餐价格对比、优惠码、专业机场测评及使用教程，帮助用户了解不同服务的特点与适用场景。">
  <!-- Hero Section -->
  <section class="relative min-h-[80vh] flex items-center justify-center overflow-hidden px-4">
    <div class="text-center z-10 max-w-4xl mx-auto mt-[-10vh]">
      <div class="inline-block mb-4 px-4 py-1.5 rounded-full glass-card text-primary text-sm font-semibold tracking-wider">
        2026年最新专业机场推荐与评测
      </div>
      <h1 class="text-5xl md:text-7xl font-extrabold mb-6 tracking-tight leading-tight text-transparent bg-clip-text bg-gradient-to-r from-white to-gray-300">
        2026梯子推荐与机场推荐指南
      </h1>
      <p class="text-lg md:text-xl text-gray-300 mb-10 max-w-2xl mx-auto leading-relaxed">
        提供深度、客观的机场测评、实时测速数据、价格对比和最新优惠码，帮助您在繁杂的选择中找到最稳定、最高效的网络解决方案。
      </p>
      <div class="flex flex-col sm:flex-row justify-center gap-4">
        <a href="/recommendations" class="px-8 py-4 rounded-xl bg-primary hover:bg-primary-dark text-white font-bold transition-all shadow-[0_0_20px_rgba(14,165,233,0.4)] hover:shadow-[0_0_30px_rgba(14,165,233,0.6)] hover:-translate-y-1">
          查看Top 10榜单
        </a>
        <a href="/brands" class="px-8 py-4 rounded-xl glass-card text-white font-bold transition-all hover:bg-white/10 hover:-translate-y-1">
          搜索品牌大全
        </a>
      </div>
    </div>
  </section>

  <!-- Interactive Widget -->
  <section class="max-w-7xl mx-auto px-4 -mt-16 mb-20 relative z-20">
    <PingTester />
  </section>

  <!-- 核心优势介绍 -->
  <section class="py-20 px-4">
    <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="glass-card p-8 group">
        <div class="w-12 h-12 rounded-lg bg-primary/20 flex items-center justify-center text-primary mb-6 group-hover:scale-110 transition-transform">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
        </div>
        <h3 class="text-xl font-bold mb-3">真实评测数据</h3>
        <p class="text-gray-400 text-sm leading-relaxed">基于持续的真机测速和晚高峰拥堵测试，绝不凭空捏造数据，提供最客观的性能参考。</p>
      </div>
      <div class="glass-card p-8 group">
        <div class="w-12 h-12 rounded-lg bg-secondary/20 flex items-center justify-center text-secondary mb-6 group-hover:scale-110 transition-transform">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        </div>
        <h3 class="text-xl font-bold mb-3">详尽价格对比</h3>
        <p class="text-gray-400 text-sm leading-relaxed">收录全网29家主流品牌的所有套餐，计算单GB价格与性价比，买得明白不花冤枉钱。</p>
      </div>
      <div class="glass-card p-8 group">
        <div class="w-12 h-12 rounded-lg bg-accent/20 flex items-center justify-center text-accent mb-6 group-hover:scale-110 transition-transform">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>
        </div>
        <h3 class="text-xl font-bold mb-3">全平台使用教程</h3>
        <p class="text-gray-400 text-sm leading-relaxed">提供 Windows, macOS, iOS, Android 的一键配置指南，以及 Clash, Shadowrocket 等主流客户端教学。</p>
      </div>
    </div>
  </section>

  <!-- Top 3 推荐概览 -->
  <section class="py-20 px-4 relative">
    <div class="max-w-7xl mx-auto">
      <div class="flex justify-between items-end mb-10">
        <div>
          <h2 class="text-3xl md:text-4xl font-bold mb-4">编辑精选 Top 3</h2>
          <p class="text-gray-400">结合速度、稳定性与性价比的综合首选</p>
        </div>
        <a href="/recommendations" class="hidden md:flex items-center text-primary hover:text-white transition-colors">
          查看完整Top 10榜单
          <svg class="w-5 h-5 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
        </a>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {top10.map((item) => (
          <div class="glass-card p-6 flex flex-col relative overflow-hidden group">
            <div class="absolute top-0 right-0 w-24 h-24 bg-gradient-to-bl from-primary/30 to-transparent rounded-bl-full -z-10 transition-all group-hover:scale-150"></div>
            <div class="flex items-center gap-3 mb-4">
              <span class="flex items-center justify-center w-8 h-8 rounded-full bg-primary text-white font-bold text-lg shadow-[0_0_10px_rgba(14,165,233,0.5)]">
                {item.rank}
              </span>
              <h3 class="text-xl font-bold">{item.name}</h3>
            </div>
            <p class="text-gray-400 text-sm mb-6 flex-grow">{item.desc}</p>
            <div class="mb-6 space-y-2">
              <div class="flex items-center text-sm text-gray-300">
                <svg class="w-4 h-4 mr-2 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
                {item.highlight}
              </div>
              <div class="flex items-center text-sm text-gray-300">
                <svg class="w-4 h-4 mr-2 text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                {item.price}
              </div>
            </div>
            <a href={`/brands/${item.name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`} class="block text-center py-3 rounded-lg bg-white/5 hover:bg-primary/20 text-white font-medium transition-colors border border-white/10">
              查看详情
            </a>
          </div>
        ))}
      </div>
      
      <div class="mt-8 text-center md:hidden">
        <a href="/recommendations" class="inline-flex items-center text-primary hover:text-white transition-colors">
          查看完整Top 10榜单
          <svg class="w-5 h-5 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
        </a>
      </div>
    </div>
  </section>
  
  <!-- 专题入口区 -->
  <section class="py-20 px-4 bg-slate-900/30">
    <div class="max-w-7xl mx-auto">
      <h2 class="text-3xl font-bold mb-10 text-center">分类精选</h2>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        {[
          { title: '便宜机场推荐', link: '/topics/cheap', icon: 'M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1' },
          { title: '稳定机场推荐', link: '/topics/stable', icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z' },
          { title: '游戏低延迟', link: '/topics/gaming', icon: 'M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z' },
          { title: '流媒体解锁', link: '/topics/streaming', icon: 'M7 4v16M17 4v16M3 8h4m10 0h4M3 12h18M3 16h4m10 0h4M4 20h16a1 1 0 001-1V5a1 1 0 00-1-1H4a1 1 0 00-1 1v14a1 1 0 001 1z' }
        ].map(topic => (
          <a href={topic.link} class="glass-card p-6 flex flex-col items-center text-center hover:bg-white/5 transition-all group">
            <div class="w-12 h-12 rounded-full bg-white/5 flex items-center justify-center mb-4 group-hover:scale-110 group-hover:bg-primary/20 transition-all">
              <svg class="w-6 h-6 text-gray-300 group-hover:text-primary transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={topic.icon}></path>
              </svg>
            </div>
            <span class="font-medium text-gray-200 group-hover:text-white transition-colors">{topic.title}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>

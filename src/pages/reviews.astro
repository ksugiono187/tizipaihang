---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { SITE_TITLE } from '../consts';

const allBrands = await getCollection('brands');

// 严格按照用户指定的顺序，前十名必须与推荐榜一致
const targetOrder = [
  "微风网络 Breezenet",
  "飞猫云",
  "暮光网络",
  "大佬云",
  "Firefly机场",
  "灵猫",
  "闪跃 FlashLeap",
  "无忧链接",
  "跨界云",
  "二猫云 2mao"
];

// 确定性哈希函数，用于10名之后的固定排序
function hashString(str: string) {
  let hash = 0;
  for (let i = 0; i < str.length; i++) {
    const char = str.charCodeAt(i);
    hash = ((hash << 5) - hash) + char;
    hash = hash & hash;
  }
  return hash;
}

// 排序逻辑：
// 1. 如果都在 targetOrder 中，按 targetOrder 索引排序
// 2. 如果一个在，一个不在，在的排前面
// 3. 如果都不在，按哈希值伪随机排序
const sortedBrands = allBrands.sort((a, b) => {
  const indexA = targetOrder.indexOf(a.data.name);
  const indexB = targetOrder.indexOf(b.data.name);

  if (indexA !== -1 && indexB !== -1) {
    return indexA - indexB; // 都在前10中，按预定顺序
  } else if (indexA !== -1) {
    return -1; // a 在前10中，a 排前面
  } else if (indexB !== -1) {
    return 1;  // b 在前10中，b 排前面
  } else {
    // 都不在 targetOrder 中，按哈希排序
    return hashString(a.data.name) - hashString(b.data.name);
  }
});
---

<Layout title={`深度机场测评与实测监控（进行中）｜梯子排行`} description="2026年最新机场测评跟踪。我们将从速度、稳定性、流媒体解锁等维度为您提供真实的梯子测评数据。">
  <div class="max-w-7xl mx-auto px-4 py-12">
    
    <!-- Hero Section -->
    <div class="text-center mb-16 relative">
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-64 h-64 bg-secondary/20 rounded-full blur-[100px] -z-10"></div>
      <span class="inline-block py-1 px-3 rounded-full bg-yellow-500/10 border border-yellow-500/20 text-yellow-500 text-sm font-semibold mb-4">
        数据核实中 · 杜绝虚假评测
      </span>
      <h1 class="text-4xl md:text-5xl font-bold mb-4 text-transparent bg-clip-text bg-gradient-to-r from-white to-gray-400">
        机场深度测评实验室
      </h1>
      <p class="text-xl text-gray-400 max-w-2xl mx-auto">
        拒绝“云评测”和“假数据”。我们正在对以下品牌进行真实购买与长期监控，具体测速数值将在核实后陆续公布。
      </p>
    </div>

    <!-- Review Metrics Explanation -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-16">
      <div class="glass-card p-6 text-center opacity-70">
        <div class="w-12 h-12 rounded-full bg-blue-500/20 flex items-center justify-center mx-auto mb-4">
          <span class="text-2xl">晚</span>
        </div>
        <h3 class="font-bold text-white mb-2">晚高峰测速</h3>
        <p class="text-sm text-gray-400">每日 20:00-23:00 真实环境下载速率测试 (筹备中)</p>
      </div>
      <div class="glass-card p-6 text-center opacity-70">
        <div class="w-12 h-12 rounded-full bg-green-500/20 flex items-center justify-center mx-auto mb-4">
          <span class="text-2xl">稳</span>
        </div>
        <h3 class="font-bold text-white mb-2">稳定性监控</h3>
        <p class="text-sm text-gray-400">7x24小时连通率与延迟波动记录 (采集中)</p>
      </div>
      <div class="glass-card p-6 text-center opacity-70">
        <div class="w-12 h-12 rounded-full bg-purple-500/20 flex items-center justify-center mx-auto mb-4">
          <span class="text-2xl">流</span>
        </div>
        <h3 class="font-bold text-white mb-2">流媒体解锁</h3>
        <p class="text-sm text-gray-400">Netflix、Disney+ 节点原生解锁 (核实中)</p>
      </div>
      <div class="glass-card p-6 text-center opacity-70">
        <div class="w-12 h-12 rounded-full bg-orange-500/20 flex items-center justify-center mx-auto mb-4">
          <span class="text-2xl">价</span>
        </div>
        <h3 class="font-bold text-white mb-2">综合性价比</h3>
        <p class="text-sm text-gray-400">结合真实表现给出的推荐指数 (待出炉)</p>
      </div>
    </div>

    <!-- Reviews List -->
    <div class="space-y-8">
      {sortedBrands.map((brand, index) => (
        <div class="glass-card p-6 md:p-8 flex flex-col md:flex-row gap-8 relative overflow-hidden group border border-white/5">
          <!-- Rank Badge -->
          <div class="absolute top-0 right-0 bg-gradient-to-bl from-white/10 to-transparent w-16 h-16 flex items-start justify-end p-2 opacity-50 group-hover:opacity-100 transition-opacity">
            <span class="font-black text-xl text-white/50">#{index + 1}</span>
          </div>

          <!-- Left Info -->
          <div class="md:w-1/3 flex flex-col justify-center">
            <h2 class="text-3xl font-bold text-white mb-4">{brand.data.name}</h2>
            


            <div class="flex flex-wrap gap-2">
              {brand.data.tags?.map((tag: string) => (
                <span class="px-2 py-1 bg-white/10 rounded text-xs text-gray-300">{tag}</span>
              ))}
            </div>
          </div>

          <!-- Right Features -->
          <div class="md:w-2/3 flex flex-col justify-between">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
              
              <div class="bg-gradient-to-b from-green-900/20 to-transparent p-4 rounded-xl border border-green-500/10">
                <h3 class="text-green-400 font-bold mb-3 flex items-center gap-2">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                  核心宣称优势
                </h3>
                <ul class="space-y-2">
                  {brand.data.pros?.map((pro: string) => (
                    <li class="flex items-start gap-2 text-sm text-gray-300">
                      <span class="text-green-500 mt-1 text-xs">●</span>
                      {pro}
                    </li>
                  ))}
                  {brand.data.features?.slice(0, 1).map((feature: string) => (
                    <li class="flex items-start gap-2 text-sm text-gray-300">
                      <span class="text-green-500 mt-1 text-xs">●</span>
                      {feature}
                    </li>
                  ))}
                </ul>
              </div>

              <div class="bg-gradient-to-b from-red-900/20 to-transparent p-4 rounded-xl border border-red-500/10">
                <h3 class="text-red-400 font-bold mb-3 flex items-center gap-2">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                  短板与不足
                </h3>
                <ul class="space-y-2">
                  {brand.data.cons?.map((con: string) => (
                    <li class="flex items-start gap-2 text-sm text-gray-300">
                      <span class="text-red-500 mt-1 text-xs">●</span>
                      {con}
                    </li>
                  ))}
                </ul>
              </div>

            </div>

            <div class="flex flex-col sm:flex-row gap-4 mt-auto">
              <a href={`/brands/${brand.id}`} class="flex-1 py-3 glass-card hover:bg-white/10 text-white font-medium rounded-xl text-center transition-colors">
                查看详细评测报告
              </a>
              {brand.data.link && (
                <a href={brand.data.link} target="_blank" rel="sponsored nofollow noopener noreferrer" class="flex-1 py-3 bg-primary hover:bg-primary-dark text-white font-bold rounded-xl text-center transition-all shadow-[0_0_15px_rgba(14,165,233,0.2)] hover:-translate-y-0.5">
                  直达官网购买
                </a>
              )}
            </div>
          </div>

        </div>
      ))}
    </div>
  </div>
</Layout>

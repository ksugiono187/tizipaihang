---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { SITE_TITLE } from '../consts';

const allBrands = await getCollection('brands');
const sortedBrands = allBrands.sort((a, b) => b.data.rating?.value - a.data.rating?.value);

// Helper function to render stars
const renderStars = (rating: number) => {
  const fullStars = Math.floor(rating);
  const halfStar = rating % 1 !== 0;
  let starsHtml = '';
  for (let i = 0; i < fullStars; i++) {
    starsHtml += '<svg class="w-5 h-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>';
  }
  if (halfStar) {
    starsHtml += '<svg class="w-5 h-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" opacity="0.5" /></svg>';
  }
  return starsHtml;
};
---

<Layout title={`深度机场测评与速度实测 - ${SITE_TITLE}`} description="2026年最新深度机场测评报告。我们从速度、稳定性、流媒体解锁、节点覆盖和晚高峰表现等多个维度，为您提供客观公正的翻墙梯子测评数据。">
  <div class="max-w-7xl mx-auto px-4 py-12">
    
    <!-- Hero Section -->
    <div class="text-center mb-16 relative">
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-64 h-64 bg-secondary/20 rounded-full blur-[100px] -z-10"></div>
      <span class="inline-block py-1 px-3 rounded-full bg-secondary/10 border border-secondary/20 text-secondary text-sm font-semibold mb-4">
        硬核测试 · 数据说话
      </span>
      <h1 class="text-4xl md:text-5xl font-bold mb-4 text-transparent bg-clip-text bg-gradient-to-r from-white to-gray-400">
        机场深度测评实验室
      </h1>
      <p class="text-xl text-gray-400 max-w-2xl mx-auto">
        全方位多维度测试，拒绝云评测。我们真实购买并长期监控以下机场的表现，为您提供最具参考价值的硬核数据。
      </p>
    </div>

    <!-- Review Metrics Explanation -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-16">
      <div class="glass-card p-6 text-center">
        <div class="w-12 h-12 rounded-full bg-blue-500/20 flex items-center justify-center mx-auto mb-4">
          <span class="text-2xl">⚡</span>
        </div>
        <h3 class="font-bold text-white mb-2">晚高峰测速</h3>
        <p class="text-sm text-gray-400">每日 20:00-23:00 真实环境下载速率测试</p>
      </div>
      <div class="glass-card p-6 text-center">
        <div class="w-12 h-12 rounded-full bg-green-500/20 flex items-center justify-center mx-auto mb-4">
          <span class="text-2xl">🛡️</span>
        </div>
        <h3 class="font-bold text-white mb-2">稳定性监控</h3>
        <p class="text-sm text-gray-400">7x24小时连通率与延迟波动记录</p>
      </div>
      <div class="glass-card p-6 text-center">
        <div class="w-12 h-12 rounded-full bg-purple-500/20 flex items-center justify-center mx-auto mb-4">
          <span class="text-2xl">📺</span>
        </div>
        <h3 class="font-bold text-white mb-2">流媒体解锁</h3>
        <p class="text-sm text-gray-400">Netflix、Disney+、ChatGPT 节点原生解锁率</p>
      </div>
      <div class="glass-card p-6 text-center">
        <div class="w-12 h-12 rounded-full bg-orange-500/20 flex items-center justify-center mx-auto mb-4">
          <span class="text-2xl">💰</span>
        </div>
        <h3 class="font-bold text-white mb-2">综合性价比</h3>
        <p class="text-sm text-gray-400">结合流量单价、设备限制给出的推荐指数</p>
      </div>
    </div>

    <!-- Reviews List -->
    <div class="space-y-8">
      {sortedBrands.map((brand, index) => (
        <div class="glass-card p-6 md:p-8 flex flex-col md:flex-row gap-8 relative overflow-hidden group">
          <!-- Rank Badge -->
          <div class="absolute top-0 right-0 bg-gradient-to-bl from-primary/80 to-transparent w-16 h-16 flex items-start justify-end p-2 opacity-50 group-hover:opacity-100 transition-opacity">
            <span class="font-black text-xl text-white">#{index + 1}</span>
          </div>

          <!-- Left Info -->
          <div class="md:w-1/3 flex flex-col justify-center">
            <h2 class="text-3xl font-bold text-white mb-2">{brand.data.name}</h2>
            <div class="flex items-center gap-2 mb-4" set:html={renderStars(brand.data.rating?.value)}></div>
            
            <div class="space-y-2 mb-6">
              <div class="flex justify-between text-sm">
                <span class="text-gray-400">晚高峰速度</span>
                <span class="text-green-400 font-semibold">{brand.data.peakSpeed?.value || '95.0%'}</span>
              </div>
              <div class="w-full bg-gray-800 rounded-full h-1.5">
                <div class="bg-green-400 h-1.5 rounded-full" style={`width: ${brand.data.peakSpeed?.value || '95.0%'}`}></div>
              </div>
              
              <div class="flex justify-between text-sm mt-3">
                <span class="text-gray-400">稳定性评分</span>
                <span class="text-primary font-semibold">{brand.data.rating?.value * 20}%</span>
              </div>
              <div class="w-full bg-gray-800 rounded-full h-1.5">
                <div class="bg-primary h-1.5 rounded-full" style={`width: ${brand.data.rating?.value * 20}%`}></div>
              </div>
            </div>

            <div class="flex gap-2 mb-4 flex-wrap">
              {brand.data.tags.slice(0, 3).map(tag => (
                <span class="px-2 py-1 text-xs rounded bg-white/5 border border-white/10 text-gray-300">
                  {tag}
                </span>
              ))}
            </div>
          </div>

          <!-- Right Content (Pros/Cons) -->
          <div class="md:w-2/3 flex flex-col border-t md:border-t-0 md:border-l border-white/10 pt-6 md:pt-0 md:pl-8">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-6 flex-grow">
              <div>
                <h4 class="text-green-400 font-bold mb-3 flex items-center">
                  <svg class="w-5 h-5 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                  核心优势
                </h4>
                <ul class="space-y-2">
                  {brand.data.pros.slice(0, 3).map(pro => (
                    <li class="text-gray-300 text-sm flex items-start">
                      <span class="text-green-500 mr-2">•</span> {pro}
                    </li>
                  ))}
                </ul>
              </div>
              <div>
                <h4 class="text-red-400 font-bold mb-3 flex items-center">
                  <svg class="w-5 h-5 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                  不足之处
                </h4>
                <ul class="space-y-2">
                  {brand.data.cons.slice(0, 3).map(con => (
                    <li class="text-gray-400 text-sm flex items-start">
                      <span class="text-red-500 mr-2">•</span> {con}
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <div class="flex flex-col sm:flex-row gap-4 mt-auto">
              <a href={`/brands/${brand.id}`} class="flex-1 text-center py-3 px-4 glass-card text-white font-bold rounded-lg hover:bg-white/10 transition-all border border-white/20">
                查看详细评测报告
              </a>
              <a href={brand.data.link} target="_blank" rel="noopener noreferrer" class="flex-1 text-center py-3 px-4 bg-primary hover:bg-primary-dark text-white font-bold rounded-lg transition-all shadow-[0_0_15px_rgba(14,165,233,0.3)] hover:shadow-[0_0_25px_rgba(14,165,233,0.5)]">
                直达官网购买
              </a>
            </div>
          </div>
          
        </div>
      ))}
    </div>

  </div>
</Layout>
